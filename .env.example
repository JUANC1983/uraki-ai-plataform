# .env.example — copy to .env and fill in values

# ---- Application ----
APP_NAME="URAKI AI Platform"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=change-me-use-a-32-char-random-string

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://uraki:uraki_pass@localhost:5432/uraki_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- JWT ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Storage ----
STORAGE_BACKEND=local          # local | s3
LOCAL_STORAGE_PATH=./storage

# S3 (if STORAGE_BACKEND=s3)
# S3_BUCKET=uraki-documents
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ---- Audit logs ----
AUDIT_LOG_TO_DB=true
AUDIT_LOG_TO_FILE=true
AUDIT_LOG_FILE=./logs/audit.jsonl

# ---- Dashboard ----
API_BASE_URL=http://localhost:8000/api/v1
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# ---- Redis (optional, for rate limiting) ----
# REDIS_URL=redis://localhost:6379/0
