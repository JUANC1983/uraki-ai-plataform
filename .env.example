# .env.example — copy to .env and fill in values

# ---- Application ----
APP_NAME="URAKI AI Platform"
APP_VERSION="1.0.0"
DEBUG=false
RUN_SCHEDULER=true
# The application rejects this sentinel until you replace it.
SECRET_KEY=change-me-in-production-min-32-chars-long

# ---- Database ----
POSTGRES_USER=uraki
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=uraki_db
DATABASE_URL=postgresql+asyncpg://uraki:replace-with-a-local-development-password@localhost:5432/uraki_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2

# ---- Vector search ----
VECTOR_STORE_BACKEND=jsonb

# ---- JWT ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8502

# ---- Storage ----
STORAGE_BACKEND=local          # local | s3
LOCAL_STORAGE_PATH=./storage
MAX_DOCUMENT_BYTES=10485760

# S3 (if STORAGE_BACKEND=s3)
# S3_BUCKET=uraki-documents
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ---- Audit logs ----
AUDIT_LOG_TO_DB=true
AUDIT_LOG_TO_FILE=true
AUDIT_LOG_FILE=./logs/audit.jsonl

# ---- Dashboard ----
API_BASE_URL=http://localhost:8000/api/v1
# Used by the modular dashboard under dashboard/
URAKI_API_URL=http://localhost:8000
URAKI_ENV=development
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# ---- Redis (optional, for rate limiting) ----
# REDIS_URL=redis://localhost:6379/0
